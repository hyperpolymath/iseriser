package eclexiaiser-abi

sourcedir = "."

modules = Eclexiaiser.ABI.Types
        , Eclexiaiser.ABI.Layout
        , Eclexiaiser.ABI.Foreign
        , Eclexiaiser.ABI.Proofs
        , Eclexiaiser.ABI.Semantics
        , Eclexiaiser.ABI.Invariants
        , Eclexiaiser.ABI.FfiSeam
        , Eclexiaiser.ABI.Capstone

-- Totality is set here: Idris2 0.8.0 refuses --total as a command-line
-- override for package commands and then checks nothing.
opts = "--total"
