# ANCHOR.a2ml - authoritative anchor for iseriser

[metadata]
version = "1.0.0"
last-updated = "2026-03-21"

[anchor]
schema = "hyperpolymath.anchor/1"
repo = "hyperpolymath/iseriser"
authority = "upstream-canonical"

purpose = [
  "Define canonical semantics and policy boundaries for the iseriser meta-framework.",
  "Declare what generated -iser repos inherit but cannot override.",
  "Provide a stable golden path for -iser generation and template expansion.",
]

[identity]
project = "iseriser"
kind = "tool"
one-sentence = "Meta-framework that generates new -iser projects from language descriptions"
domain = "code-generation, meta-tooling, language-interop"

[semantic-authority]
policy = "canonical"

owns = [
  "Template definitions for all generated -iser repos",
  "Language model schema and feature taxonomy",
  "Generation pipeline semantics and invariants",
  "ABI/FFI template correctness proofs",
]

[implementation-policy]
allowed = ["Rust", "Idris2", "Zig", "Scheme", "Shell", "Just", "AsciiDoc", "Markdown", "Handlebars"]
forbidden = ["Node.js", "npm", "TypeScript", "Python", "Go"]

[golden-path]
smoke-test-command = [
  "just test",
  "just quality",
]

success-criteria = [
  "Core tests pass",
  "Quality gates pass",
  "No unresolved critical security findings",
  "Generated repos pass cargo check",
]

[satellite-policy]
must-pin-upstream = true
must-declare-authority = true
must-have-anchor = true
must-have-golden-path = true

[semantic-authority-files]
language-spec = "SPECIFICATION.md"
formal-proofs = "src/interface/abi/"
architecture = "docs/architecture/TOPOLOGY.md"
