-- SPDX-License-Identifier: MPL-2.0
-- Idris2 package for the chapeliser ABI formal proofs.
-- Build/check with:  idris2 --build chapeliser-abi.ipkg   (from src/interface/abi/)
package chapeliser-abi

sourcedir = "."

depends = contrib

modules = Chapeliser.ABI.Types
        , Chapeliser.ABI.Layout
        , Chapeliser.ABI.Foreign
        , Chapeliser.ABI.Proofs
        , Chapeliser.ABI.Partition
        , Chapeliser.ABI.Invariants
        , Chapeliser.ABI.FfiSeam
        , Chapeliser.ABI.Capstone

-- Totality is set here: Idris2 0.8.0 refuses --total as a command-line
-- override for package commands and then checks nothing.
opts = "--total"
