-- SPDX-License-Identifier: MPL-2.0
-- Idris2 package for the verisimiser ABI formal proofs.
-- Build/check with:  idris2 --build verisimiser-abi.ipkg   (from src/interface/abi/)
package verisimiser-abi

sourcedir = "."

modules = Verisimiser.ABI.Types
        , Verisimiser.ABI.Layout
        , Verisimiser.ABI.Foreign
        , Verisimiser.ABI.Proofs
        , Verisimiser.ABI.Octad
        , Verisimiser.ABI.Invariants
        , Verisimiser.ABI.FfiSeam
        , Verisimiser.ABI.Capstone
        , Verisimiser.ABI.HashChain
        , Verisimiser.ABI.Lineage
        , Verisimiser.ABI.Version

-- Totality is set here: Idris2 0.8.0 refuses --total as a command-line
-- override for package commands and then checks nothing.
opts = "--total"
