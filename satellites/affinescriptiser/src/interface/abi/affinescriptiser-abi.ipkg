-- SPDX-License-Identifier: MPL-2.0
package affinescriptiser-abi

sourcedir = "."

modules = Affinescriptiser.ABI.Types
        , Affinescriptiser.ABI.Layout
        , Affinescriptiser.ABI.Foreign
        , Affinescriptiser.ABI.Proofs
        , Affinescriptiser.ABI.Semantics
        , Affinescriptiser.ABI.Invariants
        , Affinescriptiser.ABI.FfiSeam
        , Affinescriptiser.ABI.Capstone

-- Totality is set here: Idris2 0.8.0 refuses --total as a command-line
-- override for package commands and then checks nothing.
opts = "--total"
