package dafniser-abi

sourcedir = "."

modules = Dafniser.ABI.Types,
          Dafniser.ABI.Layout,
          Dafniser.ABI.Foreign,
          Dafniser.ABI.Proofs,
          Dafniser.ABI.Semantics,
          Dafniser.ABI.Invariants,
          Dafniser.ABI.FfiSeam,
          Dafniser.ABI.Capstone

-- Totality is set here: Idris2 0.8.0 refuses --total as a command-line
-- override for package commands and then checks nothing.
opts = "--total"
