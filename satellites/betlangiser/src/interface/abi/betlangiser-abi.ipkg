package betlangiser-abi

sourcedir = "."

modules = Betlangiser.ABI.Types
        , Betlangiser.ABI.Layout
        , Betlangiser.ABI.Foreign
        , Betlangiser.ABI.Proofs
        , Betlangiser.ABI.Semantics
        , Betlangiser.ABI.Invariants
        , Betlangiser.ABI.FfiSeam
        , Betlangiser.ABI.Capstone

-- Totality is set here: Idris2 0.8.0 refuses --total as a command-line
-- override for package commands and then checks nothing.
opts = "--total"
